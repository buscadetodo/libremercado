# Fin de línea unificado: en el repositorio todo se guarda en LF y cada copia
# local usa el de su sistema (core.autocrlf). Antes había archivos en CRLF y
# otros en LF, y cualquier edición podía aparecer como "archivo entero cambiado".
* text=auto

# Scripts de shell y configuración de contenedores: siempre LF, también en
# Windows, porque se ejecutan dentro de Docker (Linux).
*.sh text eol=lf
Dockerfile* text eol=lf
nginx.conf text eol=lf

# Binarios: nunca convertir
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
